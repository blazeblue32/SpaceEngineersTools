<local:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpaceEngineersOreRedistribution"
        x:Class="SpaceEngineersOreRedistribution.RedistributionSetup"
        Title="Redistribution Setup"
        x:Name="SetupRoot" MaxHeight="1010" Height="1000" Width="1220" CanResize="True">
    <Grid RowDefinitions="*,Auto,Auto,Auto" Margin="4">
        <local:GroupBox Grid.Row="0" Header="Ores" MinWidth="320" MinHeight="240" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="110"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" RowDefinitions="Auto,*" Margin="3" MinHeight="50">
                    <Grid ColumnDefinitions="100,70,60,70,75,75,80,55,55,150,65,60,62,62,125" HorizontalAlignment="Left" Margin="4,0,0,0">
                        <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" Margin="4,0"/><TextBlock Grid.Column="1" Text="Weight" FontWeight="SemiBold" Margin="4,0" ToolTip.Tip="Spawn weight: relative probability of this ore"/><TextBlock Grid.Column="2" Text="Size" FontWeight="SemiBold" Margin="4,0" ToolTip.Tip="Typical size: ore patches per vein (0 = random 5-30)"/><TextBlock Grid.Column="3" Text="Ratio" FontWeight="SemiBold" Margin="4,0" ToolTip.Tip="Expected ratio of all ore"/><TextBlock Grid.Column="4" Text="Depth min" FontWeight="SemiBold" Margin="4,0" ToolTip.Tip="Typical depth min: shallowest layer this ore may use (-1 = no limit)"/><TextBlock Grid.Column="5" Text="Depth max" FontWeight="SemiBold" Margin="4,0" ToolTip.Tip="Typical depth max: deepest layer this ore may use (-1 = no limit)"/><TextBlock Grid.Column="6" Text="Pref. depth" FontWeight="SemiBold" Margin="4,0" ToolTip.Tip="Preferred depth: layer the veins cluster around (-1 = random)"/><TextBlock Grid.Column="7" Text="Deep" FontWeight="SemiBold" Margin="4,0" ToolTip.Tip="Very deep ore: allow layer 9 (370 m and deeper)"/><TextBlock Grid.Column="8" Text="Layers" FontWeight="SemiBold" Margin="4,0"/><TextBlock Grid.Column="9" Text="Water" FontWeight="SemiBold" Margin="4,0"/><TextBlock Grid.Column="10" Text="Land %" FontWeight="SemiBold" Margin="4,0" ToolTip.Tip="Land + seabed ores: share of this ore's veins that start on land. Empty = baseline of the Water window, 0 = seabed only, 100 = land only, in between = preference."/><TextBlock Grid.Column="11" Text="Glob %" FontWeight="SemiBold" Margin="4,0" ToolTip.Tip="Globbing: ores tend to occur around ore of the same kind. 0 = spread evenly (default), 100 = only inside the globs (areas where this ore is common while it is rare elsewhere). The number of veins does not change, only where they are. Size and coverage of the globs: see below."/>
                    <TextBlock Grid.Column="12" Text="Glob km" FontWeight="SemiBold" Margin="4,0" ToolTip.Tip="Size of this ore's globs / regions in km (empty = the size below)"/><TextBlock Grid.Column="13" Text="Cov %" FontWeight="SemiBold" Margin="4,0" ToolTip.Tip="Share of the planet in percent inside this ore's regions at full strength (empty = the share below)"/><TextBlock Grid.Column="14" Text="Rocks" FontWeight="SemiBold" Margin="4,0" ToolTip.Tip="Geology mode: which rock types this ore forms in"/>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding OreInfos}" SelectedItem="{Binding SelectedInfo}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="100,70,60,70,75,75,80,55,55,150,65,60,62,62,125">
                                    <TextBox Height="26" MinHeight="0" Padding="4,2" VerticalContentAlignment="Center" Grid.Column="0" Margin="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Height="26" MinHeight="0" Padding="4,2" VerticalContentAlignment="Center" Grid.Column="1" Margin="1" Text="{Binding SpawnWeight, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Height="26" MinHeight="0" Padding="4,2" VerticalContentAlignment="Center" Grid.Column="2" Margin="1" Text="{Binding TypicalSize, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="3" Margin="4,0" VerticalAlignment="Center" Text="{Binding ExpectedRatio, StringFormat={}{0:P1}}" />
                                    <TextBox Height="26" MinHeight="0" Padding="4,2" VerticalContentAlignment="Center" Grid.Column="4" Margin="1" Text="{Binding TypicalDepthMin, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Height="26" MinHeight="0" Padding="4,2" VerticalContentAlignment="Center" Grid.Column="5" Margin="1" Text="{Binding TypicalDepthMax, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Height="26" MinHeight="0" Padding="4,2" VerticalContentAlignment="Center" Grid.Column="6" Margin="1" Text="{Binding PreferredDepth, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Grid.Column="7" MinHeight="0" Height="24" HorizontalAlignment="Center" IsChecked="{Binding VeryDeepOre}" />
                                    <TextBlock Grid.Column="8" Margin="4,0" VerticalAlignment="Center" Text="{Binding Layers}" ToolTip.Tip="Layers of this ore that get a number (switch layers off in the list below)."/>
                                    <ComboBox Grid.Column="9" Margin="1" HorizontalAlignment="Stretch" MinHeight="0" Height="26" Padding="6,1"
                                              SelectedIndex="{Binding WaterModeIndex, Mode=TwoWay}"
                                              IsEnabled="{Binding DataContext.WaterEnabled, ElementName=SetupRoot}"
                                              ToolTip.Tip="Land only: the whole ore layer stays above the water (layers get shallower where needed).&#x0a;Land + seabed: that rule on land, anything under standing water.&#x0a;Seabed only: sea floor and lake beds.&#x0a;Anywhere: ignore the water.">
                                        <ComboBoxItem Content="Land only (dry)"/>
                                        <ComboBoxItem Content="Land + seabed"/>
                                        <ComboBoxItem Content="Seabed only"/>
                                        <ComboBoxItem Content="Anywhere (ignore water)"/>
                                    </ComboBox>
                                    <TextBox Height="26" MinHeight="0" Padding="4,2" VerticalContentAlignment="Center" Grid.Column="10" Margin="1" Watermark="base" Text="{Binding LandShare, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding LandShareEnabled}"
                                             ToolTip.Tip="Land + seabed ores: percent of this ore's veins that start on land. Empty = baseline of the Water window. 0 = seabed only, 100 = land only, in between = preference. A layer can override it again."/>
                                    <TextBox Grid.Column="11" Height="26" MinHeight="0" Padding="4,2" VerticalContentAlignment="Center" Margin="1" Text="{Binding Glob, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip.Tip="Regional strength in percent: 0 = spread evenly, 100 = only inside its regions (globs). In geology mode the regions also follow the rock that suits the ore."/>
                                    <TextBox Grid.Column="12" Height="26" MinHeight="0" Padding="4,2" VerticalContentAlignment="Center" Margin="1" Watermark="default" Text="{Binding GlobSizeKm, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip.Tip="Size of this ore's regions in km. Empty = the size set below."/>
                                    <TextBox Grid.Column="13" Height="26" MinHeight="0" Padding="4,2" VerticalContentAlignment="Center" Margin="1" Watermark="default" Text="{Binding GlobCoverage, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip.Tip="Share of the planet in percent inside this ore's regions at full strength. Empty = the share set below."/>
                                    <Button Grid.Column="14" Height="26" MinHeight="0" Padding="4,2" Margin="1" Content="{Binding RocksSummary}" Click="RocksButton_Click"
                                            IsEnabled="{Binding DataContext.GeologyMode, ElementName=SetupRoot}"
                                            ToolTip.Tip="Rock types this ore forms in (geology mode). All equal = the ore does not care."/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Content="Add" Margin="3" Width="100" HorizontalContentAlignment="Center" Command="{Binding AddOreCommand}"/>
                    <Button Content="Remove" Margin="3" Width="100" HorizontalContentAlignment="Center" Command="{Binding RemoveOreCommand}"/>
                    <Button Content="Import" Margin="3" Width="100" HorizontalContentAlignment="Center" Command="{Binding ImportCommand}"/>
                    <Button Content="Export" Margin="3" Width="100" HorizontalContentAlignment="Center" Command="{Binding ExportCommand}"/>
                    <Button x:Name="LoadButton" Content="Load saved ▾" Margin="3" Width="110" HorizontalContentAlignment="Center" Click="LoadButton_Click"
                            ToolTip.Tip="Load the setup of the last run or one of the autosaves (every 5 minutes, newest 5 kept). Nothing is loaded automatically."/>
                    <Button Content="Update Ore Mapping Diagram" Margin="3" Click="UpdateDiagramClick"/>
                    <Button Content="Ore Overview" Margin="3" Width="100" HorizontalContentAlignment="Center" Command="{Binding ShowOverviewCommand}"/>
                    <Button Content="Sort" Margin="3" Width="80" HorizontalContentAlignment="Center" Command="{Binding SortCommand}"/>
                    <Button Content="Data packs..." Margin="3" Width="110" HorizontalContentAlignment="Center" Command="{Binding DataPacksCommand}"
                            ToolTip.Tip="Apply ore data packs: rock types (geology mode) and weights from the real abundance of each ore. Packs are files in ~/.config/OreRedistLinux/DataPacks."/>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Water, all ores:" Margin="0,0,6,0" VerticalAlignment="Center" IsEnabled="{Binding WaterEnabled}"/>
                        <ComboBox Margin="3" Width="190" SelectedIndex="{Binding BulkWaterModeIndex, Mode=TwoWay}" IsEnabled="{Binding WaterEnabled}">
                            <ComboBoxItem Content="Land only (dry)"/>
                            <ComboBoxItem Content="Land + seabed"/>
                            <ComboBoxItem Content="Seabed only"/>
                            <ComboBoxItem Content="Anywhere (ignore water)"/>
                        </ComboBox>
                        <Button Content="Apply" Margin="3" Width="70" HorizontalContentAlignment="Center" Command="{Binding ApplyWaterModeToAllCommand}"/>
                    </StackPanel>
                </WrapPanel>
                <TextBlock Grid.Row="2" Text="Ore Mapping for selected Ore: Depths 0-9 refer to these 10 mappings. Left gray bar in diagram is spawn probability." />
                <Grid Grid.Row="3" RowDefinitions="*,Auto" ColumnDefinitions="*,*" Height="370">
                    <Grid Grid.Row="0" Grid.Column="0" RowDefinitions="Auto,*" Margin="3">
                        <Grid ColumnDefinitions="40,64,60,90,90,80" HorizontalAlignment="Left" Margin="4,0,0,0">
                            <TextBlock Grid.Column="0" Text="On" FontWeight="SemiBold" Margin="4,0" ToolTip.Tip="Switch a layer off: it gets no number and is not used."/><TextBlock Grid.Column="1" Text="Number" FontWeight="SemiBold" Margin="4,0"/><TextBlock Grid.Column="2" Text="Tier" FontWeight="SemiBold" Margin="4,0"/><TextBlock Grid.Column="3" Text="Start" FontWeight="SemiBold" Margin="4,0"/><TextBlock Grid.Column="4" Text="Depth" FontWeight="SemiBold" Margin="4,0"/><TextBlock Grid.Column="5" Text="Land %" FontWeight="SemiBold" Margin="4,0" ToolTip.Tip="Land + seabed ores: overrides the ore's Land % for this layer. Empty = inherit, 0 = seabed only, 100 = land only. Example: layers 0-2 at 0 and layers 6-9 at 100 = shallow ore under the sea, deep ore under the land."/>
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding SelectedInfo.OreMappings}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="40,64,60,90,90,80">
                                    <CheckBox Grid.Column="0" Margin="4,0,0,0" MinWidth="0" MinHeight="0" Height="24" VerticalAlignment="Center" IsChecked="{Binding LayerEnabled}"/>
                                    <TextBlock Grid.Column="1" Margin="4,0" VerticalAlignment="Center" Text="{Binding ValueText}"
                                               ToolTip.Tip="Number in oremappings.xml. off = switched off here, cut = removed by Very Deep Ore or Typ. Depth Min/Max."/>
                                    <TextBlock Grid.Column="2" Margin="4,0" VerticalAlignment="Center" Text="{Binding Tier}" />
                                    <TextBox Height="26" MinHeight="0" Padding="4,2" VerticalContentAlignment="Center" Grid.Column="3" Margin="1" Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Height="26" MinHeight="0" Padding="4,2" VerticalContentAlignment="Center" Grid.Column="4" Margin="1" Text="{Binding Depth, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Height="26" MinHeight="0" Padding="4,2" VerticalContentAlignment="Center" Grid.Column="5" Margin="1" Watermark="ore" Text="{Binding LandShare, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding DataContext.SelectedInfo.LandShareEnabled, ElementName=SetupRoot}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Viewbox Grid.Column="1" Grid.Row="0" Margin="3">
                        <Canvas Width="320" Height="240" x:Name="MyCanvas" Background="LightGray" />
                    </Viewbox>
                    <Grid Grid.Column="1" Grid.Row="0" Margin="3" RowDefinitions="*,*,*,*,*,*,*,*,*,*" IsHitTestVisible="False">
                        <TextBlock Grid.Row="0" Text="0" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="White"/>
                        <TextBlock Grid.Row="1" Text="1" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="White"/>
                        <TextBlock Grid.Row="2" Text="2" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="White"/>
                        <TextBlock Grid.Row="3" Text="3" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="White"/>
                        <TextBlock Grid.Row="4" Text="4" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="White"/>
                        <TextBlock Grid.Row="5" Text="5" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="White"/>
                        <TextBlock Grid.Row="6" Text="6" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="White"/>
                        <TextBlock Grid.Row="7" Text="7" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="White"/>
                        <TextBlock Grid.Row="8" Text="8" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="White"/>
                        <TextBlock Grid.Row="9" Text="9" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="White"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <TextBlock Text="Presets:" Margin="3" VerticalAlignment="Center"/>
                        <ComboBox Width="200" Margin="3" ItemsSource="{Binding OreMappingPresets}" DisplayMemberBinding="{Binding Name}" SelectedItem="{Binding SelectedOreMappingPreset}"/>
                        <Button Content="Use selected Preset" Margin="3"  Command="{Binding LoadPresetCommand}"/>
                        <Button Content="Use for All" Margin="3"  Command="{Binding LoadPresetAllCommand}"/>
                        <Button Content="Save current values as Preset" Margin="3"  Command="{Binding SavePresetCommand}" />
                    </StackPanel>
                </Grid>
                <Expander Grid.Row="4" Header="Help: how these settings work" Margin="0,4,0,0" IsExpanded="False">
                    <TextBlock TextWrapping="Wrap" Margin="12,4,0,4" Text="Multiple definition of same ore allowed. Vanilla ore detectors have a maximum range of 150m.&#x0d;&#x0a;First start value of tier 3 (depth 6) should be within range. If ore spawns deeper it will dive from there to target depth. &#x0d;&#x0a;Weight: Spawn probability relative to other ore. Weights will be summed up to use relative %.&#x0d;&#x0a;Size: 1-500 ore patches per vein, 0 for random (5-30), default: 15&#x0d;&#x0a;Depth: 0-9 (9 only if deep ore enabled!), -1 for random (0-9), default: -1, set preferred depth to Gauss distribute around that value (std dev 4).&#x0d;&#x0a;Size will still be randomized using a Gauss distribution."/>
                </Expander>
                <WrapPanel Orientation="Horizontal" Grid.Row="5">
                    <TextBlock Text="Standard Deviation for patch size (0-50% rel. to max, default: 10%, 0=fixed): " VerticalAlignment="Center"/>
                    <TextBox Width="60" Text="{Binding StdDev, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Standard Deviation for depth (default 4): " VerticalAlignment="Center"/>
                    <TextBox Width="60" Text="{Binding StdDevDepth, UpdateSourceTrigger=PropertyChanged}"/>
                </WrapPanel>
                <StackPanel Grid.Row="6">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="Planet diameter " VerticalAlignment="Center"/>
                        <TextBox Width="80" Height="26" MinHeight="0" Padding="4,2" VerticalContentAlignment="Center" Text="{Binding PlanetDiameterKm, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" Margin="3,0,3,0" KeyDown="ApplyOnEnter"
                                 ToolTip.Tip="Diameter of the planet in km (same value as the planet radius in the Water window). Press Enter or click elsewhere to apply."/>
                        <TextBlock Text="{Binding PlanetRadiusKm, StringFormat='km  (radius {0:0.###} km). Default: EarthLike, 120 km diameter / 60 km radius.'}" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="Ore density " VerticalAlignment="Center"/>
                        <TextBox Width="70" Height="26" MinHeight="0" Padding="4,2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="3,0,3,0"
                                 Text="{Binding SpawnDensity, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}" KeyDown="ApplyOnEnter"
                                 ToolTip.Tip="Multiple of the default ore density for this planet size: 1 = default, 2 = twice as many ore patches (half the pixel distance), 0.5 = half as many. Linked to the pixel distance. Press Enter or click elsewhere to apply."/>
                        <TextBlock Text="x   =   spawn ore every " VerticalAlignment="Center"/>
                        <TextBox Width="80" Height="26" MinHeight="0" Padding="4,2" VerticalContentAlignment="Center" Text="{Binding OreSpawnRate}" HorizontalContentAlignment="Center" Margin="3,0,3,0"
                                 ToolTip.Tip="Pixels between ore patches on average. 1000 is the default for the EarthLike size. Changing the planet size recalculates this number so the patches stay the same distance apart in meters. Linked to the density."/>
                        <TextBlock Text="pixels on average (default 1000 for 120 km diameter / 60 km radius)." VerticalAlignment="Center"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding SpawnInfo}" FontWeight="SemiBold"/>
                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Ore placement: " VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox Width="150" MinHeight="0" Height="26" Padding="6,1" SelectedIndex="{Binding PlacementIndex, Mode=TwoWay}"
                                  ToolTip.Tip="Globbing: ore forms clusters (strength per ore). Geology: ore follows simulated rock types and regions (Geology menu of the main window).">
                            <ComboBoxItem Content="Globbing"/>
                            <ComboBoxItem Content="Geology"/>
                        </ComboBox>
                        <TextBlock Text="{Binding GeologyHint}" IsVisible="{Binding GeologyMode}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Globbing / ore regions: globs " VerticalAlignment="Center"/>
                        <TextBox Width="60" Height="26" MinHeight="0" Padding="4,2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="3,0,3,0" Text="{Binding GlobSizeKm, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip.Tip="Size of the globs in km (distance between the peaks and valleys of the ore fields)."/>
                        <TextBlock Text="km across; at Glob 100% an ore fills " VerticalAlignment="Center"/>
                        <TextBox Width="50" Height="26" MinHeight="0" Padding="4,2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="3,0,3,0" Text="{Binding GlobCoverage, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip.Tip="Share of the planet in percent that lies inside the globs of one ore at full strength."/>
                        <TextBlock Text="% of the planet (strength per ore: Glob % column, 0 = even; size and share can be set per ore)." VerticalAlignment="Center"/>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal" Margin="0,2,0,0" IsVisible="{Binding GeologyMode}">
                        <TextBlock Text="Geology: ore regions follow the rock " VerticalAlignment="Center"/>
                        <TextBox Width="50" Height="26" MinHeight="0" Padding="4,2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="3,0,3,0" Text="{Binding RegionRockAffinity, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip.Tip="How much the place of an ore's regions depends on the rock that suits the ore: 0 = the rock plays no part when choosing a region (a plain glob), 100 = regions lie where the rock is."/>
                        <TextBlock Text="%   (0 = regions are placed without regard to the rock, 100 = only where the rock suits the ore)" VerticalAlignment="Center"/>
                    </WrapPanel>
                </StackPanel>
                <WrapPanel Orientation="Horizontal" Grid.Row="7">
                    <TextBlock Text="Seed" VerticalAlignment="Center"/>
                    <TextBox Width="70" Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" Margin="3,0,3,0"/>
                    <CheckBox Content="Scale ore patches with the planet size" VerticalAlignment="Center" Margin="3" IsChecked="{Binding AutoPatchScale}"
                              ToolTip.Tip="Sizes in the Size column are pixels of a vein on the reference planet (EarthLike: 60 km radius, 2048 pixel tiles). On a smaller planet or with bigger tiles a pixel covers less ground, so the veins get more pixels and stay the same size on the planet. Replaces the old Small Planet Mode."/>
                    <TextBlock Text="{Binding PatchInfo}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="Gray"/>
                </WrapPanel>
            </Grid>
        </local:GroupBox>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Content="Abort" Width="150" Height="32" Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="ButtonAbort_Click" />
            <Button Content="Confirm" Width="150" Height="32" Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding ConfirmCommand}"
                    ToolTip.Tip="{Binding ConfirmProblem}" />
            <TextBlock Text="Values Count (max: 254):" VerticalAlignment="Center" Margin="5,3,3,3"/>
            <TextBlock Text="{Binding ValuesCount}" Foreground="{Binding ValuesCountBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding OreInfos.Count, StringFormat='   Ores: {0}'}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="{Binding ConfirmProblem}" Foreground="Red" FontWeight="SemiBold" TextWrapping="Wrap" Margin="8,0,6,2"/>
        <TextBlock Grid.Row="3" Text="{Binding WaterInfo}" TextWrapping="Wrap" FontSize="12" Foreground="Gray" Margin="6,0,6,4"/>
    </Grid>
</local:DialogWindow>
