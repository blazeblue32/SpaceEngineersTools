<local:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpaceEngineersOreRedistribution"
        x:Class="SpaceEngineersOreRedistribution.WaterSettingsWindow"
        Title="Water Mod settings" Width="680" SizeToContent="Height" CanResize="False">
    <StackPanel Margin="12" Spacing="8">
        <CheckBox IsChecked="{Binding Enabled}" Content="Keep ore out of the water (apply the water rules when redistributing ore)"/>
        <TextBlock Text="{Binding Source}" TextWrapping="Wrap" Foreground="Gray" FontSize="12"/>

        <Grid ColumnDefinitions="Auto,100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8" Margin="0,6,0,0">
            <TextBlock Grid.Row="0" Text="Water radius" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Radius, UpdateSourceTrigger=PropertyChanged}"/>
            <Slider Grid.Row="0" Grid.Column="2" Minimum="0" Maximum="2" Value="{Binding Radius}" />

            <TextBlock Grid.Row="1" Text="Planet radius (m)" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PlanetRadius, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" FontSize="12" Foreground="Gray" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Set when the planet is spawned, not stored in any file. Ore depth does not scale with it, but the height of the terrain does. 60000 = EarthLike (120 km diameter)."/>

            <TextBlock Grid.Row="2" Text="Tide height (m)" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TideHeight, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="3" Text="Wave height (m)" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding WaveHeight, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="4" Text="Safety margin (m)" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MarginOverride, UpdateSourceTrigger=PropertyChanged}" Watermark="{Binding Margin}"/>
            <TextBlock Grid.Row="4" Grid.Column="2" FontSize="12" Foreground="Gray" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Empty = tide + waves. Ore layers must end this far above the water line."/>

            <TextBlock Grid.Row="5" Text="Hill range min" VerticalAlignment="Center"/>
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding HillMin, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Row="5" Grid.Column="2" FontSize="12" Foreground="Gray" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="HillParams of the planet definition (fractions of the planet radius). Fill in if the definition has none."/>

            <TextBlock Grid.Row="6" Text="Hill range max" VerticalAlignment="Center"/>
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding HillMax, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="4" Padding="8">
            <StackPanel Spacing="4">
                <TextBlock Text="Ores set to &quot;Land + seabed&quot;" FontWeight="SemiBold"/>
                <RadioButton GroupName="Balance" IsChecked="{Binding SeabedByArea}"
                             Content="By area: veins land wherever the dice put them"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <RadioButton GroupName="Balance" IsChecked="{Binding SeabedFixed}" Content="Fixed: this share of the veins goes to the seabed"/>
                    <Slider Width="180" Minimum="0" Maximum="100" Value="{Binding SeabedPercent}" IsEnabled="{Binding SeabedFixed}"/>
                    <TextBlock Text="{Binding SeabedPercent, StringFormat={}{0:0}%}" VerticalAlignment="Center" Width="40"/>
                </StackPanel>
                <TextBlock FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                           Text="On land the ore layer has to stay above the water (+ margin), under water any layer is allowed. By area follows the size of land and sea, so an ocean world gets mostly seabed ore; a fixed share keeps more ore on land. If one kind of ground is missing on a cube face, the other one is used."/>
            </StackPanel>
        </Border>
        <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="4" Padding="8">
            <StackPanel Spacing="4">
                <TextBlock Text="Keeping ore rarity and density" FontWeight="SemiBold"/>
                <CheckBox IsChecked="{Binding KeepRatios}"
                          Content="Keep the ore ratios: make up for ore the water rules took away (extra veins where allowed)"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Most ore on land (x normal density)" VerticalAlignment="Center"/>
                    <TextBox Width="70" Text="{Binding LandDensityLimit, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="0 = no limit" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox IsChecked="{Binding AllowShallower}"
                          Content="Allow shallower layers when a layer does not fit (makes shallow ore more common)"/>
                <TextBlock FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                           Text="Normal density = the ore the tool places per surface pixel without water rules. When land reaches the limit, Land + seabed ores go to the seabed instead; Land only ores stay rarer (see placement_report.txt). Deep ore is only placed where its whole layer is dry, so it ends up in the highlands."/>
            </StackPanel>
        </Border>
        <Border Background="#11808080" CornerRadius="4" Padding="8">
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" MinHeight="48"/>
        </Border>
        <TextBlock FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                   Text="Each ore chooses in the redistribution window: Land only (default, the whole layer must be dry), Land + seabed, Seabed only, or Anywhere. Map &gt; Show Water tints the underwater area."/>
        <Button Content="Close" HorizontalAlignment="Right" HorizontalContentAlignment="Center" Width="100" Click="Close_Click" IsDefault="True"/>
    </StackPanel>
</local:DialogWindow>
