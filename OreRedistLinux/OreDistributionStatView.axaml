<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SpaceEngineersOreRedistribution.OreDistributionStatView">
    <Grid ColumnDefinitions="170,102,Auto,Auto,*">
        <DockPanel Grid.Column="0" Margin="3,0,6,0">
            <!-- Color tag: shows the map color of this ore, click to pick your own -->
            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4,0,0,0"
                    MinHeight="0" Height="18" Padding="6,0" CornerRadius="9"
                    BorderThickness="1.5" BorderBrush="{Binding ColorTextBrush}"
                    Background="{Binding ColorBrush}" Foreground="{Binding ColorTextBrush}"
                    FontSize="10" ToolTip.Tip="Map color of this ore. Click to choose your own."
                    Content="{Binding ColorText}">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Spacing="6">
                            <ColorView Color="{Binding Color, Mode=TwoWay}" IsAlphaEnabled="False" IsAlphaVisible="False"/>
                            <Button Content="Reset to default" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding ResetColorCommand}"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <TextBlock Text="{Binding OreType}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Border Grid.Column="1" Height="18" Width="102" Background="White" BorderBrush="Gray" BorderThickness="1" />
        <Border Grid.Column="1" Margin="1" Height="16" Width="{Binding ScaledPercentage}" Background="LawnGreen" HorizontalAlignment="Left"/>
        <TextBlock Grid.Column="2" Margin="3,0,0,0" Text="{Binding Percentage, StringFormat={}{0:N1}}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Total}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="3,0,0,0" Opacity="0.8" Foreground="Black"/>
    </Grid>
</UserControl>
